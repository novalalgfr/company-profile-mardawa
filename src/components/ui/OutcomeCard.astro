---
interface Metric {
    value: string;
    label: string;
}

interface Props {
    company: string;
    description: string;
    logo?: string;
    metrics?: Metric[];
}

const { company, description, logo, metrics = [] } = Astro.props;
---

<div class="flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="aspect-[4/3] w-full bg-[var(--color-surface-hover)]"></div>

    <div class="flex flex-1 flex-col justify-between gap-6 p-6">
        <div>
            {metrics.length > 0 && (
                <div class="mb-4 flex gap-6">
                    {metrics.map((m) => (
                        <div>
                            <span class="block text-lg font-bold text-[var(--color-primary)]">
                                {m.value}
                            </span>
                            <span class="text-xs text-[var(--color-muted)]">{m.label}</span>
                        </div>
                    ))}
                </div>
            )}
            <p class="text-sm text-[var(--color-muted)]">{description}</p>
        </div>

        <div class="flex items-center gap-2 border-t border-[var(--color-border)] pt-4">
            <div class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full border border-[var(--color-border)] bg-[var(--color-surface-hover)]">
                {logo && <img src={logo} alt={`Logo ${company}`} class="h-5 w-5 object-contain" />}
            </div>
            <span class="text-sm font-medium text-[var(--color-foreground)]">{company}</span>
        </div>
    </div>
</div>
