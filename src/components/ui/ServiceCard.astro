---
interface Props {
    title: string;
    description: string;
    index: number;
}

const { title, description, index } = Astro.props;

const formattedIndex = String(index).padStart(2, '0');
---

<div class="group rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 transition-colors hover:border-[var(--color-primary)]">
    <span class="text-sm font-medium text-[var(--color-muted)]">{formattedIndex}</span>

    <h3 class="mt-6 text-lg font-semibold text-[var(--color-foreground)]">{title}</h3>

    <p class="mt-3 text-sm text-[var(--color-muted)]">{description}</p>

    <div class="mt-6 flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-foreground)] transition-colors group-hover:border-[var(--color-primary)] group-hover:text-[var(--color-primary)]">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
        >
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
    </div>
</div>
