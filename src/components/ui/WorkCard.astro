---
interface Props {
    title: string;
    category: string;
}

const { title, category } = Astro.props;
---

<div
    class="work-card group w-[85%] flex-shrink-0 snap-start overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] sm:w-[60%] lg:w-[45%]"
    data-category={category}
>
    <div class="aspect-[16/10] w-full overflow-hidden bg-[var(--color-surface-hover)]">
        <div class="h-full w-full transition-transform duration-300 group-hover:scale-[1.03]"></div>
    </div>

    <div class="flex items-center justify-between p-5">
        <h3 class="text-base font-semibold text-[var(--color-foreground)]">{title}</h3>
        <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-muted)]">
            {category}
        </span>
    </div>
</div>
