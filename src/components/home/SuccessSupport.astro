---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import CheckItem from "../ui/CheckItem.astro";
import AvatarGroup from "../ui/AvatarGroup.astro";

const revisionChecklist = [
  { label: "Sesuaikan ukuran font untuk mobile", muted: false },
  { label: "Ganti visual atau video hero", muted: false },
  { label: "Rapikan spacing & margin konten", muted: false },
  { label: "Ganti atau update gambar", muted: false },
  { label: "Optimasi SEO dasar", muted: true },
  { label: "Sesuaikan responsivitas layout", muted: true },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
  <Container>
    <!-- Section heading -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
        Kesuksesan kamu, kami dukung
      </h2>
      <p class="mt-4 text-base text-[var(--color-muted)] sm:text-lg">
        Respons cepat, revisi yang matang, dan dukungan pasca-peluncuran yang fleksibel,
        dibuat untuk tim modern.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      <!-- Left: main benefit card -->
      <div class="flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8">
        <div>
          <h3 class="text-xl font-semibold text-[var(--color-foreground)]">
            Respons Prioritas 24/7
          </h3>
          <p class="mt-3 text-sm text-[var(--color-muted)]">
            Update mendesak ditangani cepat — permintaan prioritas selesai dalam 24 jam.
          </p>
        </div>

        <div class="mt-8 aspect-[16/10] w-full rounded-[calc(var(--radius-card)-0.5rem)] border border-[var(--color-border)] bg-[var(--color-surface-hover)]"></div>
      </div>

      <!-- Right column: stacked cards -->
      <div class="flex flex-col gap-6">
        <!-- Mini card: download brand kit -->
        <div class="flex items-center justify-between gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <div>
            <h3 class="text-base font-semibold text-[var(--color-foreground)]">
              Unduh Brand Kit Kamu
            </h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">
              Akses semua aset desain dalam satu klik — font, kode warna, template sosial & lainnya.
            </p>
            <Button href="/contact-us" class="mt-4">Unduh Toolkit</Button>
          </div>
        </div>

        <!-- Card: revision checklist -->
        <div class="flex-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-[var(--color-foreground)]">
              Perlu penyesuaian setelah peluncuran?
            </p>
            <AvatarGroup count={3} />
          </div>

          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {
              revisionChecklist.map((item) => (
                <CheckItem muted={item.muted}>{item.label}</CheckItem>
              ))
            }
          </div>

          <div class="mt-6 flex flex-col gap-1 border-t border-[var(--color-border)] pt-4 text-xs text-[var(--color-muted)]">
            <span>Berlaku hingga 90 hari setelah peluncuran.</span>
            <span>Termasuk hingga 5 revisi kecil — tanpa biaya tambahan.</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>