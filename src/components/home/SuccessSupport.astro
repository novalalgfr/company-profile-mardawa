---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import CheckItem from '../ui/CheckItem.astro';
import AvatarGroup from '../ui/AvatarGroup.astro';

const revisionChecklist = [
    { label: 'Perbaikan bug pasca-deploy', muted: false },
    { label: 'Penyesuaian alur/form input', muted: false },
    { label: 'Optimasi performa sistem', muted: false },
    { label: 'Update konten atau data master', muted: false },
    { label: 'Peningkatan keamanan dasar', muted: true },
    { label: 'Penyesuaian laporan/dashboard', muted: true },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                Sistem berjalan, dukungan tetap jalan
            </h2>
            <p class="mt-4 text-base text-[var(--color-muted)] sm:text-lg">
                Respons cepat, penanganan bug yang jelas, dan dukungan pasca-deploy yang fleksibel
                untuk instansi maupun tim internal Anda.
            </p>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-2">
            <div class="flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8">
                <div>
                    <h3 class="text-xl font-semibold text-[var(--color-foreground)]">
                        Respons Prioritas 24/7
                    </h3>
                    <p class="mt-3 text-sm text-[var(--color-muted)]">
                        Gangguan mendesak ditangani cepat, laporan prioritas kami tindak lanjuti
                        dalam 24 jam.
                    </p>
                </div>

                <img
                    src="/admin.jpg"
                    alt="Tampilan dashboard admin sistem"
                    class="mt-8 aspect-[16/10] w-full rounded-[calc(var(--radius-card)-0.5rem)] border border-[var(--color-border)] object-cover"
                />
            </div>

            <div class="flex flex-col gap-6">
                <div class="flex items-center justify-between gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
                    <div>
                        <h3 class="text-base font-semibold text-[var(--color-foreground)]">
                            Dokumentasi & Panduan Sistem
                        </h3>
                        <p class="mt-2 text-sm text-[var(--color-muted)]">
                            Akses dokumentasi teknis, panduan penggunaan, dan kredensial akses
                            sistem Anda dalam satu tempat.
                        </p>
                        <Button href="/contact-us" class="mt-4">
                            Unduh Toolkit
                        </Button>
                    </div>
                </div>

                <div class="flex-1 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
                    <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-[var(--color-foreground)]">
                            Perlu penyesuaian setelah sistem live?
                        </p>
                        <AvatarGroup count={3} />
                    </div>

                    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
                        {revisionChecklist.map((item) => (
                            <CheckItem muted={item.muted}>{item.label}</CheckItem>
                        ))}
                    </div>

                    <div class="mt-6 flex flex-col gap-1 border-t border-[var(--color-border)] pt-4 text-xs text-[var(--color-muted)]">
                        <span>Berlaku hingga 90 hari setelah sistem live.</span>
                        <span>
                            Termasuk hingga 5 permintaan penyesuaian kecil — tanpa biaya tambahan.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </Container>
</section>
