---
import Container from '../ui/Container.astro';
import StatItem from '../ui/StatItem.astro';
import LogoStrip from '../ui/LogoStrip.astro';

const miniStats = [
    { value: '$10.7M', label: 'Nilai proyek yang diluncurkan' },
    { value: '13K+', label: 'Jam kerja desain & rekayasa' },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <div class="grid items-center gap-16 lg:grid-cols-2">
            <!-- Left: text -->
            <div>
                <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                    Kami mendesain dengan tujuan. Kami membangun dengan kecerdasan.
                </h2>

                <p class="mt-6 text-base text-[var(--color-muted)] sm:text-lg">
                    Kami menciptakan brand yang siap masa depan, antarmuka SaaS yang cerdas, dan
                    website dengan konversi tinggi yang meninggalkan dampak nyata.
                </p>

                <div class="mt-10 flex gap-10">
                    {miniStats.map((stat) => (
                        <StatItem value={stat.value} label={stat.label} />
                    ))}
                </div>

                <a
                    href="/about-us"
                    class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-foreground)] hover:text-[var(--color-primary)]"
                >
                    Pelajari tentang kami
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                        />
                    </svg>
                </a>
            </div>

            <div
                class="aspect-[4/3] w-full rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)]"
                aria-label="Placeholder gambar studio"
            ></div>
        </div>

        <div class="mt-24 border-t border-[var(--color-border)] pt-16">
            <LogoStrip />
        </div>
    </Container>
</section>
