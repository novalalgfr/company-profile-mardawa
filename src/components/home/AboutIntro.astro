---
import Container from '../ui/Container.astro';
import StatItem from '../ui/StatItem.astro';
import { MoveRight } from 'lucide-astro';

const miniStats = [
    { value: '3+', label: 'Kota dengan sistem PPDB terkelola' },
    { value: '150+', label: 'Proyek diselesaikan' },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <div class="grid items-center gap-16 lg:grid-cols-2">
            <div>
                <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                    Desain yang matang, sistem yang tahan pakai.
                </h2>

                <p class="mt-6 text-base text-[var(--color-muted)] sm:text-lg">
                    Kami membangun sistem informasi, portal layanan publik, dan aplikasi yang
                    dirancang untuk dipakai setiap hari, bukan sekadar dilihat sekali lalu
                    ditinggalkan.
                </p>

                <div class="mt-10 flex gap-10">
                    {miniStats.map((stat) => (
                        <StatItem value={stat.value} label={stat.label} />
                    ))}
                </div>
                <a
                    href="/about-us"
                    class="group mt-10 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-foreground)]"
                >
                    Pelajari tentang kami
                    <MoveRight
                        size={16}
                        class="transition-transform duration-200 ease-out group-hover:translate-x-1"
                    />
                </a>
            </div>

            <img
                src="/about-us.jpg"
                alt="Tim mengerjakan sistem informasi"
                class="aspect-[4/3] w-full rounded-[var(--radius-card)] border border-[var(--color-border)] object-cover"
            />
        </div>

        <!-- <div class="mt-24 border-t border-[var(--color-border)] pt-16">
            <LogoStrip />
        </div> -->
    </Container>
</section>
