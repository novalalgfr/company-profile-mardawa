---
import Container from '../ui/Container.astro';
import OutcomeCard from '../ui/OutcomeCard.astro';
import { Sparkles } from 'lucide-astro';

const outcomes = [
    {
        company: 'Pemerintah Kota Cilegon',
        logo: '/logo-cilegon.png',
        description:
            'Membangun sistem SPMB yang menangani lonjakan pendaftar setiap musim penerimaan siswa baru.',
        metrics: [
            { value: '3+', label: 'Kota terlayani' },
            { value: '24/7', label: 'Uptime sistem saat musim buka' },
        ],
    },
    {
        company: 'Sistem Informasi Pendidikan Kota Bogor',
        description:
            'Merancang portal data pendidikan dengan identitas visual institusional yang mudah diakses publik.',
        metrics: [],
    },
    {
        company: 'Yayasan (Sistem Akuntansi)',
        description:
            'Mengembangkan aplikasi akuntansi untuk pencatatan jurnal, laporan arus kas, dan chart of accounts.',
        metrics: [],
    },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <div class="mx-auto max-w-2xl text-center">
            <div class="mb-4 flex items-center justify-center gap-2 text-sm font-medium text-[var(--color-secondary)]">
                <Sparkles class="h-4 w-4 text-[var(--color-secondary)]" />
                <span>Hasil dan Pencapaian</span>
            </div>

            <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                Hasil yang berbicara dengan sendirinya
            </h2>
            <p class="mt-4 text-base text-[var(--color-muted)] sm:text-lg">
                Kami fokus pada hasil nyata, dibangun melalui data, desain, dan inovasi. Setiap
                proyek, setiap metrik, setiap milestone berarti.
            </p>
        </div>

        <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {outcomes.map((item) => (
                <OutcomeCard
                    company={item.company}
                    description={item.description}
                    metrics={item.metrics}
                />
            ))}
        </div>
    </Container>
</section>
