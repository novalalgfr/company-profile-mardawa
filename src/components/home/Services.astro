---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import ServiceCard from '../ui/ServiceCard.astro';

const services = [
    {
        title: 'Brand Strategy & Identity',
        description:
            'Membangun fondasi brand yang jelas — dari positioning, nama, hingga visual identity.',
    },
    {
        title: 'Desain Produk & UI/UX',
        description:
            'Merancang antarmuka yang intuitif dan berorientasi konversi untuk web & mobile app.',
    },
    {
        title: 'Pengembangan Web & Aplikasi',
        description:
            'Membangun website dan aplikasi custom yang cepat, scalable, dan mudah dikelola.',
    },
    {
        title: 'Konsultasi Produk AI',
        description:
            'Membantu tim merancang dan mengintegrasikan fitur AI ke dalam produk yang sudah ada.',
    },
    {
        title: 'Konten & Marketing Visual',
        description:
            'Menghasilkan aset visual dan konten yang konsisten untuk kebutuhan kampanye brand.',
    },
    {
        title: 'Dukungan & Maintenance',
        description:
            'Pendampingan berkelanjutan pasca-peluncuran — update, perbaikan, dan iterasi produk.',
    },
];
---

<section class="bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
            <div class="max-w-xl">
                <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                    Layanan yang kami tawarkan
                </h2>
                <p class="mt-4 text-base text-[var(--color-muted)] sm:text-lg">
                    Dari strategi hingga eksekusi — kami dampingi brand dan produk kamu di setiap
                    tahap.
                </p>
            </div>

            <Button href="/services" variant="ghost">
                Lihat semua layanan
            </Button>
        </div>

        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((service, i) => (
                <ServiceCard
                    title={service.title}
                    description={service.description}
                    index={i + 1}
                />
            ))}
        </div>
    </Container>
</section>
