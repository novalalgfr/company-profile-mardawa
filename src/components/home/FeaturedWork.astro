---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import WorkCard from '../ui/WorkCard.astro';
import CarouselControls from '../ui/CarouselControls.astro';

const categories = ['Semua', 'AI', 'Fintech', 'Healthcare', 'Branding'];

const works = [
    { title: 'Nuvex AI Dashboard', category: 'AI' },
    { title: 'Paylance Wallet App', category: 'Fintech' },
    { title: 'Vitalis Health Portal', category: 'Healthcare' },
    { title: 'Orbiton Rebrand', category: 'Branding' },
    { title: 'Cortexa Assistant', category: 'AI' },
    { title: 'Ledgerly Finance Suite', category: 'Fintech' },
];

const carouselId = 'featured-work-track';
---

<section class="overflow-hidden bg-[var(--color-background)] py-24 lg:py-32">
    <Container>
        <!-- Heading + filter + controls -->
        <div class="flex flex-col gap-8">
            <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
                <div>
                    <h2 class="text-3xl font-bold leading-tight text-[var(--color-foreground)] sm:text-4xl">
                        Karya pilihan kami
                    </h2>
                    <p class="mt-4 max-w-xl text-base text-[var(--color-muted)] sm:text-lg">
                        Sekilas tentang brand dan produk yang telah kami bantu tumbuh.
                    </p>
                </div>

                <CarouselControls targetId={carouselId} />
            </div>

            <!-- Filter tags -->
            <div id="work-filter" class="flex flex-wrap items-center gap-2">
                {categories.map((cat, i) => (
                    <button
                        type="button"
                        data-filter={cat}
                        class:list={[
                            'filter-btn rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                            i === 0
                                ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-[var(--color-primary-foreground)]'
                                : 'border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-foreground)]',
                        ]}
                    >
                        {cat}
                    </button>
                ))}
            </div>
        </div>

        <!-- Carousel track -->
        <div
            id={carouselId}
            class="scrollbar-hide mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4"
        >
            {works.map((item) => (
                <WorkCard title={item.title} category={item.category} />
            ))}
        </div>

        <div class="mt-4 flex justify-center">
            <Button href="/work" variant="ghost">
                Lihat semua karya
            </Button>
        </div>
    </Container>
</section>

<style>
    /* Sembunyikan scrollbar tapi tetap bisa discroll */
    .scrollbar-hide {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    // Filter kategori
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('#work-filter .filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.work-card');

    const activeClasses = [
        'border-[var(--color-primary)]',
        'bg-[var(--color-primary)]',
        'text-[var(--color-primary-foreground)]',
    ];
    const inactiveClasses = ['border-[var(--color-border)]', 'text-[var(--color-muted)]'];

    filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
            const filter = btn.dataset.filter;

            filterButtons.forEach((b) => {
                b.classList.remove(...activeClasses);
                b.classList.add(...inactiveClasses);
            });
            btn.classList.remove(...inactiveClasses);
            btn.classList.add(...activeClasses);

            cards.forEach((card) => {
                const match = filter === 'Semua' || card.dataset.category === filter;
                card.style.display = match ? '' : 'none';
            });
        });
    });

    // Carousel prev/next
    document.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const track = document.getElementById(btn.dataset.carouselPrev!);
            const card = track?.querySelector<HTMLElement>('.work-card');
            const scrollAmount = card ? card.offsetWidth + 24 : 320;
            track?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-carousel-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const track = document.getElementById(btn.dataset.carouselNext!);
            const card = track?.querySelector<HTMLElement>('.work-card');
            const scrollAmount = card ? card.offsetWidth + 24 : 320;
            track?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
    });
</script>
