---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

const navLinks = [
    { label: 'Tentang Kami', href: '/tentang-kami' },
    { label: 'Galeri', href: '/galeri' },
    { label: 'Produk', href: '/produk' },
    { label: 'Blog', href: '/blog' },
    // { label: "Pricing", href: "/pricing" },
];
---

<header class="absolute inset-x-0 top-0 z-50">
    <Container class="flex items-center justify-between py-6">
        <!-- Logo -->
        <a href="/" class="text-lg font-bold text-[var(--color-foreground)]">
            Mardawa
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-8 lg:flex">
            {navLinks.map((link) => (
                <a
                    href={link.href}
                    class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-[var(--color-foreground)]"
                >
                    {link.label}
                </a>
            ))}
        </nav>

        <!-- CTA desktop -->
        <div class="hidden lg:block">
            <Button href="/contact-us">Book a Call</Button>
        </div>

        <!-- Mobile toggle -->
        <button
            id="mobile-menu-toggle"
            class="flex items-center justify-center rounded-full border border-[var(--color-border)] p-2 lg:hidden"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <svg
                id="icon-open"
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-[var(--color-foreground)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                class="hidden h-5 w-5 text-[var(--color-foreground)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </Container>

    <!-- Mobile menu panel -->
    <div
        id="mobile-menu"
        class="hidden flex-col gap-1 border-t border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-4 lg:hidden"
    >
        {navLinks.map((link) => (
            <a
                href={link.href}
                class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-muted)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-foreground)]"
            >
                {link.label}
            </a>
        ))}
        <Button href="/contact-us" class="mt-2 w-full">
            Book a Call
        </Button>
    </div>
</header>

<script>
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle?.addEventListener('click', () => {
        const isOpen = menu?.classList.contains('flex');

        menu?.classList.toggle('hidden');
        menu?.classList.toggle('flex');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
        toggle?.setAttribute('aria-expanded', String(!isOpen));
    });
</script>
